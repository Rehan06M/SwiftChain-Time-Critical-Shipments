# Run backend commands from the backend directory.

PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swiftchain_db
DB_USER=postgres
DB_PASSWORD=

# Generate locally:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Google Web OAuth Client ID
GOOGLE_CLIENT_ID=

# Python intelligence service
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8000

# Background monitoring
REDIS_URL=redis://127.0.0.1:6379
SLA_MONITOR_INTERVAL_MS=30000

# Development account seed only.
# Choose a password of at least 12 characters.
DEV_SEED_PASSWORD=

GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=xxx

# Production PostgreSQL is Neon database neondb.
# Use the complete connection string supplied by Neon.
DATABASE_URL=

# Run the SLA process alongside Express on a demo deployment.
RUN_SLA_WORKER=false